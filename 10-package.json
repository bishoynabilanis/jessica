{
  "name": "jessica-edu-pwa",
  "private": true,
  "version": "1.0.0",
  "description": "Jessica — an AI-powered, gamified learning companion for Egyptian first-preparatory language school students.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/vendor-files.mjs",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "content": "node scripts/generate-features.mjs && node scripts/generate-quiz.mjs && node scripts/generate-guides.mjs && node scripts/generate-topics.mjs && node scripts/generate-install.mjs && node scripts/generate-seasonal.mjs && node scripts/generate-seo.mjs && node scripts/generate-subjects.mjs && node scripts/generate-html-sitemap.mjs && node scripts/generate-feed.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.1.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cairo": "^5.1.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^11.11.17",
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.462.0",
    "mermaid": "^11.4.1",
    "pdfjs-dist": "^4.9.155",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "5.1.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mlc-ai/web-llm": "0.2.89",
    "@playwright/test": "^1.65.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.11"
  }
